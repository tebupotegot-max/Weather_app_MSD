<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WeatherApp.ViewModels"
             xmlns:models="clr-namespace:WeatherApp.Models"
             x:Class="WeatherApp.MainPage"
             x:DataType="vm:WeatherViewModel"
             Shell.NavBarIsVisible="False">

    <RefreshView Command="{Binding RefreshCommand}"
                 IsRefreshing="{Binding IsRefreshing}"
                 RefreshColor="#FF9500">
        <ScrollView>
            <VerticalStackLayout Padding="16,56,16,48" Spacing="0">

                <Grid x:Name="LoadingView"
                      IsVisible="{Binding IsLoading}"
                      HeightRequest="400"
                      VerticalOptions="Center">
                    <VerticalStackLayout Spacing="18" VerticalOptions="Center">
                        <ActivityIndicator IsRunning="{Binding IsLoading}"
                                           Color="White"
                                           WidthRequest="36"
                                           HeightRequest="36"
                                           HorizontalOptions="Center" />
                        <Label Text="Fetching weather…"
                               TextColor="#C0FFFFFF"
                               FontSize="15"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Grid>

              
          
                <VerticalStackLayout x:Name="ContentView"
                                      IsVisible="{Binding HasData}"
                                      Opacity="0"
                                      Spacing="0">

                    <!-- ── HERO ── -->
                    <Label Text="📍 My Location"
                           TextColor="#D0FFFFFF"
                           FontSize="13"
                           HorizontalOptions="Center"
                           CharacterSpacing="0.2"
                           Margin="0,0,0,2" />

                    <Label Text="{Binding CityName}"
                           TextColor="White"
                           FontSize="30"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"
                           Margin="0,0,0,0" />

                    <Label HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"
                           LineHeight="0.92"
                           Margin="0,0,0,-4">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{Binding Temperature}" TextColor="White" FontSize="88" />
                                <Span Text="°" TextColor="White" FontSize="60" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <Label Text="{Binding ConditionDesc}"
                           TextColor="#D0FFFFFF"
                           FontSize="18"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"
                           Margin="0,4,0,6" />

                    <Label HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"
                           Margin="0,0,0,10">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="H:" TextColor="#90FFFFFF" FontSize="15" />
                                <Span Text="{Binding TempMax}" TextColor="#E0FFFFFF" FontSize="15" FontAttributes="Bold" />
                                <Span Text="°" TextColor="#90FFFFFF" FontSize="15" />
                                <Span Text="  ·  " TextColor="#60FFFFFF" FontSize="15" />
                                <Span Text="L:" TextColor="#90FFFFFF" FontSize="15" />
                                <Span Text="{Binding TempMin}" TextColor="#E0FFFFFF" FontSize="15" FontAttributes="Bold" />
                                <Span Text="°" TextColor="#90FFFFFF" FontSize="15" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                 
                    <Border x:Name="Card1"
                            BackgroundColor="White"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 16"
                            Opacity="0"
                            Padding="16,14,16,12"
                            Margin="0,0,0,10">
                        <Border.Shadow>
                            <Shadow Brush="Black" Offset="0,2" Radius="12" Opacity="0.08" />
                        </Border.Shadow>

                        <VerticalStackLayout Spacing="0">

                            <Label Text="⏱  HOURLY FORECAST"
                                   TextColor="#8E8E93"
                                   FontSize="10"
                                   FontAttributes="Bold"
                                   CharacterSpacing="1.5"
                                   Margin="0,0,0,10" />

                            <BoxView HeightRequest="1" BackgroundColor="#F0F0F5" Margin="0,0,0,8" />

                            <CollectionView ItemsSource="{Binding HourlyForecast}"
                                            HeightRequest="90"
                                            SelectionMode="None">
                                <CollectionView.ItemsLayout>
                                    <LinearItemsLayout Orientation="Horizontal" ItemSpacing="0" />
                                </CollectionView.ItemsLayout>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="models:HourlyItem">
                                        <VerticalStackLayout WidthRequest="60"
                                                              HorizontalOptions="Center"
                                                              VerticalOptions="Center"
                                                              Spacing="4"
                                                              Padding="4,0">
                                            <Label Text="{Binding Time}"
                                                   TextColor="#8E8E93"
                                                   FontSize="13"
                                                   HorizontalOptions="Center"
                                                   HorizontalTextAlignment="Center" />
                                            <Label Text="{Binding Icon}"
                                                   FontSize="22"
                                                   HorizontalOptions="Center"
                                                   HorizontalTextAlignment="Center" />
                                            <Label Text="{Binding TempStr}"
                                                   TextColor="#1C1C1E"
                                                   FontSize="15"
                                                   FontAttributes="Bold"
                                                   HorizontalOptions="Center"
                                                   HorizontalTextAlignment="Center" />
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>

                        </VerticalStackLayout>
                    </Border>

                  
                    <Border x:Name="Card2"
                            BackgroundColor="White"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 16"
                            Opacity="0"
                            Padding="16,14"
                            Margin="0,0,0,10">
                        <Border.Shadow>
                            <Shadow Brush="Black" Offset="0,2" Radius="12" Opacity="0.08" />
                        </Border.Shadow>

                        <VerticalStackLayout Spacing="0">

                            <Label Text="🌅  SUNRISE &amp; SUNSET"
                                   TextColor="#8E8E93"
                                   FontSize="10"
                                   FontAttributes="Bold"
                                   CharacterSpacing="1.5"
                                   Margin="0,0,0,2" />

                            <!-- Sun arc progress bar -->
                            <ProgressBar Progress="{Binding SunProgress}"
                                         ProgressColor="#FF9500"
                                         HeightRequest="4"
                                         Margin="0,12,0,8" />

                            <!-- Rise / Now / Set labels -->
                            <Grid ColumnDefinitions="*,*,*">

                                <VerticalStackLayout Grid.Column="0" HorizontalOptions="Start" Spacing="2">
                                    <Label Text="🌄"
                                           FontSize="20"
                                           HorizontalOptions="Start" />
                                    <Label Text="Rise"
                                           TextColor="#8E8E93"
                                           FontSize="12" />
                                    <Label Text="{Binding SunriseTime}"
                                           TextColor="#1C1C1E"
                                           FontSize="15"
                                           FontAttributes="Bold" />
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="2">
                                    <Label Text="☀️"
                                           FontSize="20"
                                           HorizontalOptions="Center" />
                                    <Label Text="Now"
                                           TextColor="#FF9500"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           HorizontalOptions="Center" />
                                    <Label Text="{Binding CurrentTimeStr}"
                                           TextColor="#FF9500"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           HorizontalOptions="Center" />
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="2" HorizontalOptions="End" Spacing="2">
                                    <Label Text="🌇"
                                           FontSize="20"
                                           HorizontalOptions="End" />
                                    <Label Text="Set"
                                           TextColor="#8E8E93"
                                           FontSize="12"
                                           HorizontalOptions="End" />
                                    <Label Text="{Binding SunsetTime}"
                                           TextColor="#1C1C1E"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           HorizontalOptions="End" />
                                </VerticalStackLayout>

                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <Grid x:Name="Card3"
                          ColumnDefinitions="*,10,*"
                          Opacity="0"
                          Margin="0,0,0,10">

                        <!-- Humidity -->
                        <Border Grid.Column="0"
                                BackgroundColor="White"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 16"
                                Padding="16,14">
                            <Border.Shadow>
                                <Shadow Brush="Black" Offset="0,2" Radius="12" Opacity="0.08" />
                            </Border.Shadow>
                            <VerticalStackLayout Spacing="2">
                                <Label Text="💧  HUMIDITY"
                                       TextColor="#8E8E93"
                                       FontSize="10"
                                       FontAttributes="Bold"
                                       CharacterSpacing="1.5"
                                       Margin="0,0,0,4" />
                                <Label TextColor="#1C1C1E" FontSize="28" FontAttributes="Bold">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding Humidity}" />
                                            <Span Text="%" TextColor="#8E8E93" FontSize="18" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <Label Text="{Binding HumidityDesc}"
                                       TextColor="#8E8E93"
                                       FontSize="13" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Wind -->
                        <Border Grid.Column="2"
                                BackgroundColor="White"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 16"
                                Padding="16,14">
                            <Border.Shadow>
                                <Shadow Brush="Black" Offset="0,2" Radius="12" Opacity="0.08" />
                            </Border.Shadow>
                            <VerticalStackLayout Spacing="2">
                                <Label Text="💨  WIND"
                                       TextColor="#8E8E93"
                                       FontSize="10"
                                       FontAttributes="Bold"
                                       CharacterSpacing="1.5"
                                       Margin="0,0,0,4" />
                                <Label TextColor="#1C1C1E" FontSize="28" FontAttributes="Bold">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding WindSpeed}" />
                                            <Span Text=" m/s" TextColor="#8E8E93" FontSize="16" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <Label Text="{Binding WindDirection}"
                                       TextColor="#8E8E93"
                                       FontSize="13" />
                            </VerticalStackLayout>
                        </Border>

                    </Grid>

               
                    <Grid x:Name="Card4"
                          ColumnDefinitions="*,10,*"
                          Opacity="0"
                          Margin="0,0,0,10">

                        <!-- Pressure -->
                        <Border Grid.Column="0"
                                BackgroundColor="White"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 16"
                                Padding="16,14">
                            <Border.Shadow>
                                <Shadow Brush="Black" Offset="0,2" Radius="12" Opacity="0.08" />
                            </Border.Shadow>
                            <VerticalStackLayout Spacing="2">
                                <Label Text="⬇  PRESSURE"
                                       TextColor="#8E8E93"
                                       FontSize="10"
                                       FontAttributes="Bold"
                                       CharacterSpacing="1.5"
                                       Margin="0,0,0,4" />
                                <Label TextColor="#1C1C1E" FontSize="28" FontAttributes="Bold">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding Pressure}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <Label Text="hPa"
                                       TextColor="#8E8E93"
                                       FontSize="13" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Visibility -->
                        <Border Grid.Column="2"
                                BackgroundColor="White"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 16"
                                Padding="16,14">
                            <Border.Shadow>
                                <Shadow Brush="Black" Offset="0,2" Radius="12" Opacity="0.08" />
                            </Border.Shadow>
                            <VerticalStackLayout Spacing="2">
                                <Label Text="👁  VISIBILITY"
                                       TextColor="#8E8E93"
                                       FontSize="10"
                                       FontAttributes="Bold"
                                       CharacterSpacing="1.5"
                                       Margin="0,0,0,4" />
                                <Label TextColor="#1C1C1E" FontSize="28" FontAttributes="Bold">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding Visibility}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <Label Text="km"
                                       TextColor="#8E8E93"
                                       FontSize="13" />
                            </VerticalStackLayout>
                        </Border>

                    </Grid>

                   
                    <Border x:Name="Card5"
                            BackgroundColor="White"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 16"
                            Opacity="0"
                            Padding="16,14"
                            Margin="0,0,0,10">
                        <Border.Shadow>
                            <Shadow Brush="Black" Offset="0,2" Radius="12" Opacity="0.08" />
                        </Border.Shadow>
                        <Grid ColumnDefinitions="*,1,*">

                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="🌡️  FEELS LIKE"
                                       TextColor="#8E8E93"
                                       FontSize="10"
                                       FontAttributes="Bold"
                                       CharacterSpacing="1.5"
                                       Margin="0,0,0,4" />
                                <Label TextColor="#1C1C1E" FontSize="28" FontAttributes="Bold">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding FeelsLike}" />
                                            <Span Text="°" TextColor="#8E8E93" FontSize="20" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <Label Text="{Binding FeelsLikeDesc}"
                                       TextColor="#8E8E93"
                                       FontSize="13" />
                            </VerticalStackLayout>

                            <BoxView Grid.Column="1" BackgroundColor="#F0F0F5" WidthRequest="1" VerticalOptions="Fill" Margin="0,4" />

                            <VerticalStackLayout Grid.Column="2" Spacing="2" Margin="16,0,0,0">
                                <Label Text="⏱  LAST UPDATED"
                                       TextColor="#8E8E93"
                                       FontSize="10"
                                       FontAttributes="Bold"
                                       CharacterSpacing="1.5"
                                       Margin="0,0,0,4" />
                                <Label Text="{Binding LastUpdated}"
                                       TextColor="#1C1C1E"
                                       FontSize="14"
                                       FontAttributes="Bold" />
                                <Label Text="Updates every 5 min"
                                       TextColor="#8E8E93"
                                       FontSize="13" />
                            </VerticalStackLayout>

                        </Grid>
                    </Border>

                    
                    <Border x:Name="RefreshBtn"
                            BackgroundColor="White"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 28"
                            HeightRequest="54"
                            Opacity="0">
                        <Border.Shadow>
                            <Shadow Brush="Black" Offset="0,2" Radius="10" Opacity="0.07" />
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding RefreshCommand}" />
                        </Border.GestureRecognizers>
                        <Label Text="↻  Refresh Now"
                               TextColor="#1C1C1E"
                               FontSize="15"
                               FontAttributes="Bold"
                               CharacterSpacing="0.2"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>

                </VerticalStackLayout>

            
                <VerticalStackLayout x:Name="ErrorView"
                                      IsVisible="{Binding HasError}"
                                      HorizontalOptions="Center"
                                      Spacing="16"
                                      Margin="0,80,0,0"
                                      Opacity="0">
                    <Label Text="⚠️"
                           FontSize="56"
                           HorizontalOptions="Center" />
                    <Label Text="{Binding ErrorMessage}"
                           TextColor="#D0FFFFFF"
                           FontSize="16"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"
                           LineBreakMode="WordWrap"
                           MaximumWidthRequest="280" />
                    <Border BackgroundColor="White"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 28"
                            HeightRequest="52"
                            Margin="0,8,0,0">
                        <Border.Shadow>
                            <Shadow Brush="Black" Offset="0,2" Radius="10" Opacity="0.08" />
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding RefreshCommand}" />
                        </Border.GestureRecognizers>
                        <Label Text="Try Again"
                               TextColor="#1C1C1E"
                               FontSize="15"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>

</ContentPage>
